# ---- Frontend (variáveis VITE_ são públicas, nunca coloque segredos aqui) ----
VITE_CONVEX_URL=
VITE_STORE_NAME=
VITE_STORE_URL=

# ---- Segredos Convex (NÃO ficam neste arquivo) ----
# Configure com: npx convex env set NOME valor
# Serão adicionados nas fases seguintes (nomes exatos conforme a documentação oficial):
#   Mercado Pago: access token e webhook secret
#   Melhor Envio: MELHOR_ENVIO_CLIENT_ID, MELHOR_ENVIO_CLIENT_SECRET, MELHOR_ENVIO_ENV (sandbox|production)
#     (SHIPPING_MOCK=true = tarifs fictifs, développement uniquement) — voir docs/SHIPPING_MELHOR_ENVIO.md
#   Mercado Livre: client id e client secret
#   Provedor de e-mail
# Autenticação (Convex Auth): configurada por `npx @convex-dev/auth`
